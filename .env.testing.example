# Automated testing template. Copy to .env.testing (never committed).
#
# Laravel loads this file when APP_ENV=testing, which is set by phpunit.xml and
# by the app-test container in docker/compose.test.yaml.
#
# Deliberately isolated from local development: separate database, separate
# Redis instance, different host ports, synchronous queue, array cache/session.
# RabbitMQ variables are absent on purpose - tests never talk to the broker.

APP_NAME=CRM-Test
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stderr

# Separate test database served by the crm-test compose stack.
DB_CONNECTION=pgsql
DB_HOST=pg-test
DB_PORT=5432
DB_DATABASE=crm_testing
DB_USERNAME=crm_test
DB_PASSWORD=change-me-test-local

SESSION_DRIVER=array
CACHE_STORE=array
CACHE_PREFIX=crm-test-cache-

QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=null
MAIL_MAILER=array

# Available for lock/cache integration tests; unused by the array cache store.
REDIS_CLIENT=phpredis
REDIS_HOST=redis-test
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=crm-test-redis-

# Host ports of the test stack (must not collide with the development stack).
DB_HOST_PORT=5433
REDIS_HOST_PORT=6380
