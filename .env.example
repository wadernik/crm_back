# Local development template. Copy to .env (never committed) and replace the
# placeholder credentials with developer-managed values (owner decision Q17).
# All composer/artisan commands run inside the Docker app image, so hosts refer
# to container names, not to 127.0.0.1.

APP_NAME=CRM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# ru default with en fallback (owner decision Q25); dates stay UTC in the
# database and are localised at the application edge (owner decision Q24).
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (owner decision Q2: replaces MySQL)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=crm_dev
DB_USERNAME=crm_dev
DB_PASSWORD=change-me-local-dev

SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Realtime is deferred (Reverb decision pending); broadcasts are inert locally.
BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local

# RabbitMQ queue driver (owner decision Q3, option A: AMQP bridge package).
QUEUE_CONNECTION=rabbitmq

# Redis: cache store and Cache::lock() (owner decision Q19).
CACHE_STORE=redis
CACHE_PREFIX=crm-dev-cache-
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=crm-dev-redis-

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=crm_dev
RABBITMQ_PASSWORD=change-me-local-dev
RABBITMQ_VHOST=crm_dev
RABBITMQ_QUEUE=default
RABBITMQ_WORKER=default

MAIL_MAILER=log

# Ports published by Compose to 127.0.0.1 only.
HTTP_HOST_PORT=8000
DB_HOST_PORT=5432
REDIS_HOST_PORT=6379
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

# Retained from the Laravel skeleton for the frontend build (not used yet).
VITE_APP_NAME="${APP_NAME}"
