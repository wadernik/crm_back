flowchart TD
    NEW["Новый заказ"]
    WORK["В работе"]
    PRINT["Распечатан"]
    APPROVAL["Ожидает согласования"]
    REWORK["Отправлен на доработку"]
    READY["Готов к передаче в магазин"]
    COURIER["Передан курьеру"]
    STORE["Передан в магазин"]
    PICKUP["Готов к выдаче"]
    DONE["Исполнен"]
    CANCEL["Отменен"]

    NEW --> WORK
    WORK --> PRINT
    WORK --> APPROVAL
    PRINT --> APPROVAL
    APPROVAL --> REWORK
    REWORK --> WORK
    APPROVAL --> READY
    READY --> COURIER
    COURIER --> STORE
    STORE --> PICKUP
    PICKUP --> DONE

    NEW -. "менеджер / администратор" .-> CANCEL
    WORK -. "менеджер / администратор" .-> CANCEL
    PRINT -. "менеджер / администратор" .-> CANCEL
    APPROVAL -. "менеджер / администратор" .-> CANCEL
    REWORK -. "менеджер / администратор" .-> CANCEL
    READY -. "менеджер / администратор" .-> CANCEL
    COURIER -. "менеджер / администратор" .-> CANCEL
    STORE -. "менеджер / администратор" .-> CANCEL
    PICKUP -. "менеджер / администратор" .-> CANCEL

    DONE:::terminal
    CANCEL:::terminal

    classDef terminal fill:#dcefe2,stroke:#398454,color:#173d27
